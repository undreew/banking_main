PORT=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_APP_API_VERSION=

# Browser-facing API prefix (relative: served by this app and rewritten to the backend)
NEXT_PUBLIC_API=/api/v1

# Where the Next.js server forwards /api/* (server-side only, never exposed to the browser)
API_INTERNAL_URL=http://localhost:8080

# Name of the HttpOnly access cookie the route guard checks for presence (not a secret)
NEXT_PUBLIC_ACCESS_COOKIE_NAME=access_token